    {
      "id": "ribbon",
      "name": "Ribbon",
      "description": "Insular letters rebuilt as channeled bands and threaded with original alternating over-and-under interlace strands.",
      "source_author": "Dieter Steffmann / Typographer Mediengestaltung",
      "source_name": "Carrick Caps",
      "source_url": "https://ctan.org/tex-archive/fonts/initials",
      "complete_unmodified_collection": "https://mirrors.ctan.org/fonts/initials.zip",
      "source_copyright_date": "source notice retained",
      "license": "LPPL-1.3c-or-later",
      "modified_work_declaration": "This is a modified work, maintained under the distinct name Ribbon. It is not the unmodified original Carrick Caps. The new ornament and contour construction are identified below.",
      "design_changes": [
        "Isolated Carrick\u2019s weighty insular letter construction with a morphological opening; removed most original thin interlace and outline details.",
        "Discarded tiny remnant components and rebuilt body edges with a light closing operation.",
        "Cut new inset channels following the complete letter contours and counters.",
        "Drew three new continuous ornamental strands and two foreground crossing segments; erased the understrands at the crossings to make genuine interlace.",
        "Preserved historical letter identity and roof/foot construction while materially replacing the ornament; independently redrew I and T for distinct anatomy, strengthened E\u2019s exposed middle arm, and extended Q\u2019s tail."
      ],
