    {
      "id": "thornwood",
      "name": "Thornwood",
      "description": "Floriated woodcut letters with sharp medieval silhouettes and original lobed thorn leaves, cut veins, rosettes, branch spirals and double keylines.",
      "source_author": "Dieter Steffmann / Typographer Mediengestaltung",
      "source_name": "Morris Initialen",
      "source_url": "https://ctan.org/tex-archive/fonts/initials",
      "complete_unmodified_collection": "https://mirrors.ctan.org/fonts/initials.zip",
      "source_copyright_date": "2000",
      "license": "LPPL-1.3c-or-later",
      "modified_work_declaration": "This is a modified work, maintained under the distinct name Thornwood. It is not the unmodified original Morris Initialen. The new ornament and contour construction are identified below.",
      "design_changes": [
        "Extracted only the interior historic letter body from each Morris initial; removed every original outer foliage and frame component.",
        "Renormalized body proportions and redrew the ornamental composition from new path data.",
        "Added original cut-vein lobed thorn foliage, per-letter seeded leaf positions, branch spirals, two rosettes and outer letter keylines.",
        "Added sparse new engraved cuts to the thick letter strokes; preserved E\u2019s separately encoded crossbar."
      ],
