    {
      "id": "scriptorium",
      "name": "Scriptorium",
      "description": "Illuminated penwork versals with historic blackletter anatomy, newly incised stem scrolls and extensive open curling pen sprays.",
      "source_author": "Dieter Steffmann / Typographer Mediengestaltung",
      "source_name": "Royal Initialen",
      "source_url": "https://ctan.org/tex-archive/fonts/initials",
      "complete_unmodified_collection": "https://mirrors.ctan.org/fonts/initials.zip",
      "source_copyright_date": "1999",
      "license": "LPPL-1.3c-or-later",
      "modified_work_declaration": "This is a modified work, maintained under the distinct name Scriptorium. It is not the unmodified original Royal Initialen. The new ornament and contour construction are identified below.",
      "design_changes": [
        "Reconstructed the Royal historic silhouettes with a closing operation and selective counter preservation, removing and merging fine source ornament.",
        "Added new engraved S-scroll cuts throughout available stem interiors.",
        "Recomposed open spaces with eight original calligraphic branching sprays, lobed leaf terminals and ink beads.",
        "Replaced the original visual composition with a wider freely branching penwork silhouette."
      ],
